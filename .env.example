# Public URL of this app, used in invite and reset links.
APP_URL=https://kickaccount.vercel.app

# KickAccount's own Supabase project (auth + accounting schema).
NEXT_PUBLIC_SUPABASE_URL=https://qxnrdnstvkvvnuidpiax.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# KickAccount database, as kickaccount_app (transaction pooler, port 6543).
ACCOUNTS_DB_HOST=aws-0-eu-west-2.pooler.supabase.com
ACCOUNTS_DB_USER=kickaccount_app.qxnrdnstvkvvnuidpiax
ACCOUNTS_DB_PASSWORD=

# Kickio database, as the read-only kickaccount_reader (transaction pooler).
# Kickio is on a different pooler cluster (aws-1) from KickAccount (aws-0).
KICKIO_DB_HOST=aws-1-eu-west-2.pooler.supabase.com
KICKIO_DB_USER=kickaccount_reader.rlveellvebfzgyobceru
KICKIO_DB_PASSWORD=
